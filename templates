<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Momentum Dashboard Pro</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 40px 20px; }
        .card { max-width: 600px; margin: 0 auto; background: #1e293b; padding: 30px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); }
        h1 { margin-top: 0; color: #38bdf8; font-size: 24px; text-align: center; }
        .input-group { display: flex; gap: 10px; margin: 20px 0; }
        input { flex: 1; padding: 12px; border-radius: 6px; border: 1px solid #334155; background: #0f172a; color: white; font-size: 16px; }
        button { padding: 12px 20px; background: #0284c7; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
        button:hover { background: #0369a1; }
        .metric-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
        .metric { background: #334155; padding: 12px; border-radius: 6px; }
        .metric-label { font-size: 12px; color: #94a3b8; text-transform: uppercase; }
        .metric-value { font-size: 18px; font-weight: bold; margin-top: 4px; }
        .error { color: #f87171; text-align: center; margin-top: 15px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Momentum Dashboard Pro</h1>
        <div class="input-group">
            <input type="text" id="symbol" placeholder="Enter Ticker Symbol (e.g. SBIN, TCS, RELIANCE)">
            <button onclick="analyze()">Analyze</button>
        </div>
        <div id="results"></div>
    </div>

    <script>
        async function analyze() {
            const sym = document.getElementById("symbol").value.trim();
            const container = document.getElementById("results");
            if (!sym) return;

            container.innerHTML = "<p style='text-align:center;'>Fetching stock data...</p>";

            try {
                const response = await fetch(`/api/analyze/${sym}`);
                const res = await response.json();

                if (res.status === "success") {
                    const data = res.data.data.analysis;
                    container.innerHTML = `
                        <div class="metric-grid">
                            <div class="metric"><div class="metric-label">Price</div><div class="metric-value">₹${data.price}</div></div>
                            <div class="metric"><div class="metric-label">Signal</div><div class="metric-value">${data.recommendation}</div></div>
                            <div class="metric"><div class="metric-label">RSI (14)</div><div class="metric-value">${data.rsi}</div></div>
                            <div class="metric"><div class="metric-label">ADX</div><div class="metric-value">${data.adx}</div></div>
                            <div class="metric"><div class="metric-label">Support</div><div class="metric-value">₹${data.support}</div></div>
                            <div class="metric"><div class="metric-label">Resistance</div><div class="metric-value">₹${data.resistance}</div></div>
                        </div>
                    `;
                } else {
                    container.innerHTML = `<div class="error">${res.message}</div>`;
                }
            } catch (err) {
                container.innerHTML = `<div class="error">Failed to connect to backend server.</div>`;
            }
        }
    </script>
</body>
</html>
